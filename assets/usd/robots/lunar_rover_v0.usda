#usda 1.0
(
    defaultPrim = "LunarRover"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "LunarRover" (
    customData = {
        string description = "Rover lunar mínimo para Lab 01"
        double lunar_gravity_m_s2 = 1.62
        double mass_kg = 45
    }
)
{
    def Xform "Chassis"
    {
        def Cube "Body"
        {
            double size = 1
            float3 xformOp:scale = (1.2, 0.8, 0.35)
            double3 xformOp:translate = (0, 0, 0.53)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }

        def Cube "SolarPanel"
        {
            double size = 1
            float3 xformOp:scale = (0.95, 0.6, 0.03)
            double3 xformOp:translate = (0, 0, 0.72)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }
    }

    def Xform "Wheels"
    {
        def Cylinder "FrontLeft" (
            customData = {
                string component = "wheel"
            }
        )
        {
            double height = 0.12
            double radius = 0.18
            float xformOp:rotateX = 90
            double3 xformOp:translate = (0.42, 0.46, 0.18)
            uniform token[] xformOpOrder = ["xformOp:rotateX", "xformOp:translate"]
        }

        def Cylinder "FrontRight" (
            customData = {
                string component = "wheel"
            }
        )
        {
            double height = 0.12
            double radius = 0.18
            float xformOp:rotateX = 90
            double3 xformOp:translate = (0.42, -0.46, 0.18)
            uniform token[] xformOpOrder = ["xformOp:rotateX", "xformOp:translate"]
        }

        def Cylinder "RearLeft" (
            customData = {
                string component = "wheel"
            }
        )
        {
            double height = 0.12
            double radius = 0.18
            float xformOp:rotateX = 90
            double3 xformOp:translate = (-0.42, 0.46, 0.18)
            uniform token[] xformOpOrder = ["xformOp:rotateX", "xformOp:translate"]
        }

        def Cylinder "RearRight" (
            customData = {
                string component = "wheel"
            }
        )
        {
            double height = 0.12
            double radius = 0.18
            float xformOp:rotateX = 90
            double3 xformOp:translate = (-0.42, -0.46, 0.18)
            uniform token[] xformOpOrder = ["xformOp:rotateX", "xformOp:translate"]
        }
    }

    def Xform "Sensors" (
        customData = {
            double camera_fov_degrees = 90
        }
    )
    {
        def Cube "FrontCamera"
        {
            double size = 1
            float3 xformOp:scale = (0.1, 0.14, 0.08)
            double3 xformOp:translate = (0.62, 0, 0.7)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }

        def Cube "Antenna"
        {
            double size = 1
            float3 xformOp:scale = (0.03, 0.03, 0.4)
            double3 xformOp:translate = (-0.35, 0, 0.94)
            uniform token[] xformOpOrder = ["xformOp:scale", "xformOp:translate"]
        }
    }
}

