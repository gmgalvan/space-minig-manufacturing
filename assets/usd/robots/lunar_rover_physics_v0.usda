#usda 1.0
(
    defaultPrim = "LunarRover"
    metersPerUnit = 1
    upAxis = "Z"
)

def Xform "LunarRover" (
    customData = {
        string description = "Minimal lunar rover for Lab 01"
        double lunar_gravity_m_s2 = 1.62
        double mass_kg = 45
        string physics_backend_target = "NVIDIA PhysX / Isaac Sim"
        bool physics_ready = 1
    }
)
{
    def Xform "Chassis" (
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
        customData = {
            string physics_role = "chassis"
        }
    )
    {
        float physics:mass = 35

        def Cube "Body" (
            prepend apiSchemas = ["PhysicsCollisionAPI"]
        )
        {
            double size = 1
            float3 xformOp:scale = (1.2, 0.8, 0.35)
            double3 xformOp:translate = (0, 0, 0.53)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "SolarPanel"
        {
            double size = 1
            float3 xformOp:scale = (0.95, 0.6, 0.03)
            double3 xformOp:translate = (0, 0, 0.72)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def Xform "Wheels"
    {
        def Cylinder "FrontLeft" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
            customData = {
                string component = "wheel"
            }
        )
        {
            uniform token axis = "Y"
            double height = 0.12
            float physics:mass = 2.5
            double radius = 0.18
            double3 xformOp:translate = (0.42, 0.46, 0.18)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "FrontRight" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
            customData = {
                string component = "wheel"
            }
        )
        {
            uniform token axis = "Y"
            double height = 0.12
            float physics:mass = 2.5
            double radius = 0.18
            double3 xformOp:translate = (0.42, -0.46, 0.18)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "RearLeft" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
            customData = {
                string component = "wheel"
            }
        )
        {
            uniform token axis = "Y"
            double height = 0.12
            float physics:mass = 2.5
            double radius = 0.18
            double3 xformOp:translate = (-0.42, 0.46, 0.18)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }

        def Cylinder "RearRight" (
            prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI", "PhysicsCollisionAPI"]
            customData = {
                string component = "wheel"
            }
        )
        {
            uniform token axis = "Y"
            double height = 0.12
            float physics:mass = 2.5
            double radius = 0.18
            double3 xformOp:translate = (-0.42, -0.46, 0.18)
            uniform token[] xformOpOrder = ["xformOp:translate"]
        }
    }

    def Xform "Sensors" (
        customData = {
            double camera_fov_degrees = 90
        }
    )
    {
        def Cube "FrontCamera"
        {
            double size = 1
            float3 xformOp:scale = (0.1, 0.14, 0.08)
            double3 xformOp:translate = (0.62, 0, 0.7)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }

        def Cube "Antenna"
        {
            double size = 1
            float3 xformOp:scale = (0.03, 0.03, 0.4)
            double3 xformOp:translate = (-0.35, 0, 0.94)
            uniform token[] xformOpOrder = ["xformOp:translate", "xformOp:scale"]
        }
    }

    def "Joints"
    {
        def PhysicsRevoluteJoint "FrontLeftAxle" (
            customData = {
                bool drive_candidate = 1
            }
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </LunarRover/Chassis>
            rel physics:body1 = </LunarRover/Wheels/FrontLeft>
            point3f physics:localPos0 = (0.42, 0.46, 0.18)
            point3f physics:localPos1 = (0, 0, 0)
        }

        def PhysicsRevoluteJoint "FrontRightAxle" (
            customData = {
                bool drive_candidate = 1
            }
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </LunarRover/Chassis>
            rel physics:body1 = </LunarRover/Wheels/FrontRight>
            point3f physics:localPos0 = (0.42, -0.46, 0.18)
            point3f physics:localPos1 = (0, 0, 0)
        }

        def PhysicsRevoluteJoint "RearLeftAxle" (
            customData = {
                bool drive_candidate = 1
            }
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </LunarRover/Chassis>
            rel physics:body1 = </LunarRover/Wheels/RearLeft>
            point3f physics:localPos0 = (-0.42, 0.46, 0.18)
            point3f physics:localPos1 = (0, 0, 0)
        }

        def PhysicsRevoluteJoint "RearRightAxle" (
            customData = {
                bool drive_candidate = 1
            }
        )
        {
            uniform token physics:axis = "Y"
            rel physics:body0 = </LunarRover/Chassis>
            rel physics:body1 = </LunarRover/Wheels/RearRight>
            point3f physics:localPos0 = (-0.42, -0.46, 0.18)
            point3f physics:localPos1 = (0, 0, 0)
        }
    }
}

